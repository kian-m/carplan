# Copy to .env and fill in. Leave blank to disable an integration.

# Capital One Nessie — get a key at https://api.nessieisreal.com (log in with GitHub)
NESSIE_API_KEY=

# SerpApi — https://serpapi.com/manage-api-key
SERPAPI_API_KEY=

# Gemini — if AI Studio says "API keys are disallowed", create the key in Cloud Console instead:
# APIs & Services > Credentials > Create credentials > API key, tick "Authenticate API calls
# through a service account", then restrict it to the Generative Language API.
# Vertex AI express-mode keys (restricted to aiplatform.googleapis.com) need GEMINI_VERTEX=true.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_VERTEX=false

# Tiger Data — create a free service at https://console.cloud.timescale.com, copy the connection string
TIGER_DATABASE_URL=

# Snowflake Cortex (optional) — account URL + programmatic access token
SNOWFLAKE_ACCOUNT_URL=
SNOWFLAKE_PAT=

# Add your deployed frontend origin here when you deploy (JSON list)
CORS_ORIGINS=["http://localhost:3000"]

# Resend — recall alert emails: https://resend.com/api-keys
RESEND_API_KEY=
PUBLIC_APP_URL=http://localhost:3000
