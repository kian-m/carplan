# Copy to .env and fill in. Leave blank to disable an integration.

# Capital One Nessie — get a key at http://api.nessieisreal.com (log in with GitHub)
NESSIE_API_KEY=

# SerpApi — https://serpapi.com/manage-api-key
SERPAPI_API_KEY=

# Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Tiger Data — create a free service at https://console.cloud.timescale.com, copy the connection string
TIGER_DATABASE_URL=

# Snowflake Cortex (optional) — account URL + programmatic access token
SNOWFLAKE_ACCOUNT_URL=
SNOWFLAKE_PAT=

# Add your deployed frontend origin here when you deploy (JSON list)
CORS_ORIGINS=["http://localhost:3000"]
